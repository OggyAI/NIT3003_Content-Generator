# Copy this file to .env.local and fill in the values (never commit .env.local).
# Supabase dashboard → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key — either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Only Oggy and Vercel have the real key — teammates leave this
# blank and test AI generation on the Vercel deployment instead.
OPENAI_API_KEY=
OPENAI_MODEL=

# Billing (Stripe TEST mode only; plan approved 15 Nov 2026). All server-only: never NEXT_PUBLIC_.
# Stripe dashboard (Test mode) → Developers → API keys. Use the sk_test_ key, never sk_live_.
STRIPE_SECRET_KEY=
# The price id (price_...) of the "Pro" product, A$19/month recurring
STRIPE_PRO_PRICE_ID=
# Locally: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# On Vercel: from the webhook endpoint you add in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Supabase → Project Settings → API Keys → service_role / secret key. Bypasses RLS:
# used ONLY by app/api/stripe/webhook/route.ts. Never share it or commit it.
SUPABASE_SERVICE_ROLE_KEY=
