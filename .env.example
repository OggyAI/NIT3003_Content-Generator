# Copy this file to .env.local and fill in the values (never commit .env.local).
# Supabase dashboard → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key — either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Only Oggy and Vercel have the real key — teammates leave this
# blank and test AI generation on the Vercel deployment instead.
OPENAI_API_KEY=
OPENAI_MODEL=
